[Unit]
Description=ZikriLLah Telegram bot, API and web
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=120
StartLimitBurst=10

[Service]
Type=simple
User=zikrillah
Group=zikrillah
WorkingDirectory=/opt/zikrillah/app
EnvironmentFile=/etc/zikrillah/zikrillah.env
ExecStart=/opt/zikrillah/node/bin/node /opt/zikrillah/app/bot/index.js
Restart=on-failure
RestartSec=10
TimeoutStopSec=30
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/zikrillah

[Install]
WantedBy=multi-user.target
